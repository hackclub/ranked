# Hack Club Auth — same OAuth scopes as Desktop/turfwars
AUTH_CLIENTID=
AUTH_CLIENTSECRET=
AUTH_REDIRECT_URI=http://localhost:3000/api/auth/hackclub/callback
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
HCAUTH_BASE_URL=https://auth.hackclub.com

# Automatic YSWS submission after each GitHub Pages deployment
# Token scopes: schema.bases:read, data.records:read, data.records:write
AIRTABLE_API=
AIRTABLE_BASE_ID=appWhszMexYwrDfKY
AIRTABLE_SUBMISSIONS_TABLE_ID=tbl13RI05Gn6NHa3C

# Hackatime OAuth — confidential app, scopes: profile read
HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=
HACKATIME_REDIRECT_URI=http://localhost:3000/api/auth/hackatime/callback
HACKATIME_OAUTH_SCOPE=profile read
HACKATIME_BASE_URL=https://hackatime.hackclub.com
HACKATIME_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Public base URL for OAuth redirects
APP_BASE_URL=http://localhost:3000

# PostgreSQL (Neon recommended; standard postgres:// or postgresql:// URL)
DATABASE_URL=
VOTES_TO_FINALIZE=3

# GitHub OAuth App — callback URL must match exactly
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback
GITHUB_OAUTH_SCOPE=repo

# Liveblocks secret API key for authenticated Yjs rooms + WebRTC signaling
LIVEBLOCKS_SECRET_KEY=

# Optional TURN server for calls across restrictive networks
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
