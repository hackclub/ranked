# Hack Club Auth — same OAuth scopes as Desktop/turfwars
AUTH_CLIENTID=
AUTH_CLIENTSECRET=
AUTH_REDIRECT_URI=http://localhost:3000/api/auth/hackclub/callback
# 32+ random characters (openssl rand -base64 48). Encrypts the session cookie;
# the app refuses to start a session on a short or placeholder value.
AUTH_SESSION_SECRET=
HCAUTH_BASE_URL=https://auth.hackclub.com

# Resolves a player's HCA slack_id into their actual Slack handle for display.
# Bot token scope: users:read. Missing/invalid token just means slack_username
# stays unset (player is prompted to set one manually in onboarding) — it does
# not break sign-in.
SLACK_BOT_TOKEN=

# Automatic YSWS submission after each GitHub Pages deployment
# Token scopes: schema.bases:read, data.records:read, data.records:write
AIRTABLE_API=
AIRTABLE_BASE_ID=appWhszMexYwrDfKY
AIRTABLE_SUBMISSIONS_TABLE_ID=tbl13RI05Gn6NHa3C

# Hackatime OAuth — confidential app, scopes: profile read
HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=
HACKATIME_REDIRECT_URI=http://localhost:3000/api/auth/hackatime/callback
HACKATIME_OAUTH_SCOPE=profile read
HACKATIME_BASE_URL=https://hackatime.hackclub.com
# 32+ random characters (openssl rand -base64 48), different from the one above.
HACKATIME_TOKEN_ENCRYPTION_KEY=

# Public base URL for OAuth redirects
APP_BASE_URL=http://localhost:3000

# Staff access. Comma-separated Hack Club Auth email addresses; leave empty and
# nobody has the role. Kept out of the source so the repository never says who
# holds it.
#   ADMIN_EMAILS: admin tools (audit log, ELO adjustment, test lobbies).
#   RECORDING_REVIEWER_EMAILS: may watch private match recordings. A separate
#   list on purpose: being an admin does not grant this.
ADMIN_EMAILS=
RECORDING_REVIEWER_EMAILS=

# PostgreSQL (Neon recommended; standard postgres:// or postgresql:// URL)
DATABASE_URL=
VOTES_TO_FINALIZE=3

# GitHub App user authorization — callback URL must match exactly.
# Repository permissions: Contents, Pages, and Administration read/write.
# Enable "Request user authorization (OAuth) during installation" on the app:
# onboarding sends players to the installation URL first (authorizing alone
# grants no repository access at all), and that setting is what returns them
# with an authorization code.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback
# The app's slug — the name in its github.com/apps/<slug> URL, not its client
# ID. Only needed to point a staging deployment at a different app.
GITHUB_APP_SLUG=hack-club-ranked

# Liveblocks secret API key for authenticated Yjs rooms + WebRTC signaling
LIVEBLOCKS_SECRET_KEY=

# Private match recordings in Cloudflare R2. Keep this bucket private.
# Token permissions: Object Read & Write for this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_RECORDINGS_BUCKET=

# A player in a live match whose recording stops reaching storage is flagged in
# the audit log, has their camera and microphone withheld from the call, and
# is refused new call tokens until clips arrive again. This is on whenever the
# R2 values above are set. Set to "off" only to keep calls working through a
# storage outage; calls are then unrecorded.
RECORDING_ENFORCEMENT=

# Random 32+ character value used to authenticate the daily 10-day retention job.
CRON_SECRET=

# Shop shipping addresses are stored encrypted. 32+ random characters
# (openssl rand -base64 48). Optional: without it they are encrypted under a
# key derived from AUTH_SESSION_SECRET, which works, but means rotating that
# secret makes the addresses on open orders unreadable. Set this once and keep
# it; fulfilment (npm run shop:orders) needs the same value.
SHIPPING_ENCRYPTION_KEY=

# Optional TURN server for calls across restrictive networks. All of these are
# server-side only: the browser is handed short-lived credentials per match by
# /api/matches/[matchId]/ice-servers, so nothing here is built into the bundle.
# Pick ONE of the three options.
#
# 1. Cloudflare Realtime TURN (credentials expire on their own):
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# 2. Any TURN server with shared-secret auth (coturn "use-auth-secret").
#    TURN_URLS is comma-separated, e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URLS=
TURN_SHARED_SECRET=
# 3. A fixed username/password (works, but can't expire — prefer 1 or 2):
TURN_USERNAME=
TURN_CREDENTIAL=
# How long issued credentials last, in seconds (default 21600 = 6 hours).
TURN_CREDENTIAL_TTL_SECONDS=
# Set to "true" to send all call media through TURN. Players in a call then
# never see each other's IP addresses; the cost is that every call is relayed
# (and billed) by your TURN server. Has no effect unless TURN is configured.
TURN_RELAY_ONLY=
