{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --hostname 0.0.0.0",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "test": "NITRO_PRESET=vercel npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .output --ignore-pattern .vercel --ignore-pattern .wrangler",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:migrate:hackatime": "npm run db:migrate",
    "db:wipe-users": "node scripts/wipe-users.mjs",
    "db:clear-matches": "node scripts/clear-matches.mjs"
  },
  "dependencies": {
    "@liveblocks/client": "^3.23.0",
    "@liveblocks/node": "^3.23.0",
    "@liveblocks/yjs": "^3.23.0",
    "@monaco-editor/react": "^4.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "html-to-image": "^1.11.13",
    "monaco-editor": "^0.56.0",
    "next": "16.2.11",
    "nitro": "^3.0.260610-beta",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.20.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "pg": "^8.22.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.16"
  },
  "overrides": {
    "dompurify": "3.4.13",
    "esbuild": "0.25.9",
    "postcss": "8.5.23",
    "sharp": "0.35.0"
  },
  "type": "module"
}
